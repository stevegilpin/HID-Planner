<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HIDUI.Views"
        xmlns:vm="clr-namespace:HIDUI.ViewModels"
        xmlns:dt="using:HIDUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="HIDUI.Views.MainWindow"
        x:CompileBindings="False"
        Icon="/Assets/avalonia-logo.ico"
        Title="HIDUI"
        Background="#252525"
        WindowState="Maximized">

    <!-- <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="Red" />
        </Style>
    </Window.Styles> -->

    <StackPanel>
        <!-- <views:SchedulingView DataContext="{ Binding CurrentPage }"/> -->
        <!-- DataContext="{ Binding CurrentPage }" tried adding this into TransitioningContentControl-->
        
        <ContentControl Content="{ Binding CurrentPage }"/>
        <Button Command="{ Binding GoToSchedulingView }" Content="Scheduling View &gt;"></Button>
        <Button Command="{ Binding GoToSurveyView }" Content="&lt; Survey View"></Button>
    </StackPanel>
</Window>
