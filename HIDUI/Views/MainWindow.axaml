<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HIDUI.Views"
        xmlns:vm="clr-namespace:HIDUI.ViewModels"
        xmlns:dt="using:HIDUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="450"
        x:Class="HIDUI.Views.MainWindow"
        x:CompileBindings="False"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HIDUI"
        Background="#252525"
        WindowState="Maximized">

    <DockPanel VerticalAlignment="Stretch">
        <views:CourseOptionsView DockPanel.Dock="Top" Name="CourseOptionsView" IsVisible="False" Content="{ Binding CourseOptionsViewModel }"/>
        <views:SurveyView DockPanel.Dock="Top" Name="SurveyView" IsVisible="False" Content="{ Binding SurveyViewModel }"/>
        <views:SchedulingView DockPanel.Dock="Top" Name="SchedulingView" IsVisible="True" Content="{ Binding SchedulingViewModel }"/>
        <views:SettingsView DockPanel.Dock="Top" Name="SettingsView" IsVisible="False" Content="{ Binding SettingsViewModel }"/>

        <Grid VerticalAlignment="Bottom" ColumnDefinitions="*, *, *, *">
            <Button Grid.Column="0" Click="GoToCourseOptionsView_OnClick">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontSize="20" FontWeight="Bold">Course Options View</TextBlock>
            </Button>
            <Button Grid.Column="1" Click="GoToSurveyView_OnClick">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontSize="20" FontWeight="Bold">Survey View</TextBlock>
            </Button>
            <Button Grid.Column="2" Click="GoToSchedulingView_OnClick">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontSize="20" FontWeight="Bold">Scheduling View</TextBlock>
            </Button>
            <Button Grid.Column="3" Click="GoToSettingsView_OnClick">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontSize="20" FontWeight="Bold">Settings View</TextBlock>
            </Button>
        </Grid>
    </DockPanel>
</Window>
