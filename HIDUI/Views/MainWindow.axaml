<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:HIDUI.Views"
        xmlns:vm="clr-namespace:HIDUI.ViewModels"
        xmlns:dt="using:HIDUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1800" d:DesignHeight="450"
        x:Class="HIDUI.Views.MainWindow"
        x:CompileBindings="False"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="HIDUI"
        Background="#252525"
        WindowState="Maximized">

    <TabControl SelectedIndex="2" Margin="5" TabStripPlacement="Left">
        <TabItem Header="Course Options">
            <views:CourseOptionsView DockPanel.Dock="Top" Name="CourseOptionsView" Content="{ Binding CourseOptionsViewModel }"/>
        </TabItem>
        <TabItem Header="Survey">
            <views:SurveyView DockPanel.Dock="Top" Name="SurveyView" Content="{ Binding SurveyViewModel }"/>
        </TabItem>
        <TabItem Header="Scheduling">
            <views:SchedulingView DockPanel.Dock="Top" Name="SchedulingView" Content="{ Binding SchedulingViewModel }"/>
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView DockPanel.Dock="Top" Name="SettingsView" Content="{ Binding SettingsViewModel }"/>
        </TabItem>
    </TabControl>
</Window>
