<UserControl xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:views="clr-namespace:HIDUI.Views"
                            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                            x:Class="HIDUI.Views.FileSelectionControl">
    <Border
        Name="Border"
        BorderBrush="Gray" 
        BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
        <StackPanel>
            <TextBlock Text="{ Binding $parent[views:FileSelectionControl].DisplayName }"/>
            <StackPanel Name="FileChoicePanel" Orientation="Horizontal" IsVisible="False">
                <Button Name="DeleteButton" Classes="delete" Background="Transparent" Click="RemoveButton_Click">
                    <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
                </Button>
                <TextBlock Name="FileNameTextBlock" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
