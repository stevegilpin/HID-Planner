<UserControl x:Class="HIDUI.Views.SchedulingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             xmlns:analytics="clr-namespace:HIDLib.Analytics;assembly=HIDLib"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SchedulingViewModel"
             mc:Ignorable="d">
    
    <Grid ColumnDefinitions="*, 2, *">
        <StackPanel>
            <TextBlock HorizontalAlignment="Center" Padding="12" FontSize="18" FontWeight="SemiBold">Select Input Files for Courses, Schedule, Students, and Student Choices</TextBlock>
            
            <Button HorizontalAlignment="Center" Padding="12" Click="ImportFilesOnClick">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontWeight="Bold">Choose Files</TextBlock>
            </Button>
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <Border BorderBrush="{ Binding CoursesStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5" Grid.Row="0" Grid.Column="0">
                    <StackPanel>
                        <TextBlock>Courses</TextBlock>
                        <StackPanel IsVisible="{ Binding IsCoursesFileSet }" Orientation="Horizontal">
                            <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveCoursesFile }">
                                <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{ Binding CoursesFileName }"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ Binding ScheduleStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5" Grid.Row="0" Grid.Column="1">
                    <StackPanel>
                        <TextBlock>Schedule</TextBlock>
                        <StackPanel IsVisible="{ Binding IsScheduleFileSet }" Orientation="Horizontal">
                            <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveScheduleFile }">
                                <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{ Binding ScheduleFileName }" ToolTip.Tip="{ Binding ScheduleFilePath }"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ Binding StudentsStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5" Grid.Row="1" Grid.Column="0">
                    <StackPanel>
                        <TextBlock>Students</TextBlock>
                        <StackPanel IsVisible="{ Binding IsStudentsFileSet }" Orientation="Horizontal">
                            <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveStudentsFile }">
                                <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{ Binding StudentsFileName }"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ Binding StudentChoicesStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5" Grid.Row="1" Grid.Column="1">
                    <StackPanel>
                        <TextBlock>Student Choices</TextBlock>
                        <StackPanel IsVisible="{ Binding IsStudentChoicesFileSet }" Orientation="Horizontal">
                            <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveStudentChoicesFile }">
                                <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" Text="{ Binding StudentChoicesFileName }"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Button HorizontalAlignment="Center" Padding="12" Command="{ Binding RunScheduling }">
                <TextBlock HorizontalAlignment="Center" Padding="50 8" FontWeight="Bold">
                    Run Scheduling
                </TextBlock>
            </Button>
            <ScrollViewer Height="400">
                <DataGrid Margin="20" 
                        ItemsSource="{ Binding Runs }"
                        IsReadOnly="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="All"
                        BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Run ID" Width="*" Binding="{ Binding RunId }"/>
                        <DataGridTextColumn Header="Time" Width="*" Binding="{ Binding TimeStamp }" />
                        <DataGridTextColumn Header="Score" Width="*" Binding="{ Binding TotalObjectiveScore }" />
                        <DataGridTextColumn Header="# Bad Results" Width="*" Binding="{ Binding BadAssignmentsCount }" />
                        <DataGridTemplateColumn Width="*" Header="View">
                            <DataTemplate DataType="analytics:SchedulingRunAnalyticData">
                                <Button Click="TableRowViewReports" 
                                        x:Name="Check" 
                                        Name="{ Binding RunId }">
                                    View
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" Header="Save">
                            <DataTemplate DataType="analytics:SchedulingRunAnalyticData">
                                <Button Click="TableRowSaveData" 
                                        x:Name="Check" 
                                        Name="{ Binding RunId }">
                                    Save
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </StackPanel>

        <GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>

        <DataGrid Margin="20" 
                ItemsSource="{ Binding RunDetails }"
                IsReadOnly="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="All"
                BorderThickness="1">
            <DataGrid.Columns>
                <!-- <DataGridTextColumn Header="Run ID" Width="*" Binding="{ Binding RunId }"/>
                <DataGridTextColumn Header="Time" Width="*" Binding="{ Binding TimeStamp }" />
                <DataGridTextColumn Header="Score" Width="*" Binding="{ Binding TotalObjectiveScore }" />
                <DataGridTextColumn Header="# Bad Results" Width="*" Binding="{ Binding BadAssignmentsCount }" /> -->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>