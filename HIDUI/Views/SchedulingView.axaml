<UserControl x:Class="HIDUI.Views.SchedulingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             xmlns:analytics="clr-namespace:HIDLib.Analytics;assembly=HIDLib"
             xmlns:views="clr-namespace:HIDUI.Views"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SchedulingViewModel"
             mc:Ignorable="d">
    
    <Control.Styles>
        <StyleInclude Source="/ButtonStyles.axaml" />
    </Control.Styles>
    
    <Grid ColumnDefinitions=".6*, 2, .4*">
        <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,*">
            <Button  Grid.Row="0" HorizontalAlignment="Center" Click="ImportFilesOnClick">
                Choose Input Files
            </Button>
            <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*,*,*">
                <views:FileSelectionControl
                    Grid.Row="0" Grid.Column="0"
                    Name="CoursesFileSelector"
                    DisplayName="Courses"
                    FilePath="{Binding CoursesFilePath }"
                    RemoveFileCommand="{Binding RemoveCoursesFile }"/>

                <views:FileSelectionControl
                    Grid.Row="0" Grid.Column="1"
                    Name="ScheduleFileSelector"
                    DisplayName="Schedule"
                    FilePath="{Binding ScheduleFilePath }"
                    RemoveFileCommand="{Binding RemoveScheduleFile }"/>

                <views:FileSelectionControl
                    Grid.Row="1" Grid.Column="0"
                    Name="StudentsFileSelector"
                    DisplayName="Students"
                    FilePath="{Binding StudentsFilePath }"
                    RemoveFileCommand="{Binding RemoveStudentsFile }"/>

                <views:FileSelectionControl
                    Grid.Row="1" Grid.Column="1"
                    Name="StudentChoicesFileSelector"
                    DisplayName="Student Choices"
                    FilePath="{Binding StudentChoicesFilePath }"
                    RemoveFileCommand="{Binding RemoveStudentChoicesFile }"/>

                <views:FileSelectionControl
                    Grid.Row="2" Grid.Column="1"
                    Name="SchedulingResultsFileSelector"
                    DisplayName="Scheduling Results (optional)"
                    FilePath="{Binding SchedulingResultsFilePath }"
                    RemoveFileCommand="{Binding RemoveSchedulingResultsFile }"/>
                
                <Button Grid.Row="3" Grid.Column="0" Width="NaN" HorizontalAlignment="Stretch" Command="{ Binding RunScheduling }" IsEnabled="{ Binding InputsAreReady }">
                    Run Scheduling
                </Button>
                <Button Grid.Row="3" Grid.Column="1" Width="NaN" HorizontalAlignment="Stretch" Command="{ Binding SaveManualScheduling }" IsEnabled="{ Binding ManualInputsAreReady }">
                    Save Manual Scheduling
                </Button>
            </Grid>
            
            <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="10" FontSize="18">Scheduling Runs</TextBlock>
            <DataGrid Grid.Row="3" Margin="20" 
                      ItemsSource="{ Binding Runs }"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="1"
                      Name="RunGrid"
                      SelectionChanged="DataGrid_OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Run ID" Width="*" Binding="{ Binding RunId }"/>
                    <DataGridTextColumn Header="Time" Width="*" Binding="{ Binding TimeStamp }" />
                    <DataGridTextColumn Header="Name" Width="*" Binding="{ Binding Name }" />
                    <DataGridTextColumn Header="Score" Width="*" Binding="{ Binding TotalObjectiveScore }" />
                    <DataGridTextColumn Header="# Bad Results" Width="*" Binding="{ Binding BadAssignmentsCount }" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>
        <Grid Grid.Column="2" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <DockPanel Grid.Row="0">
                <TextBlock Padding="10">Run Name:</TextBlock>
                <TextBox HorizontalAlignment="Stretch" Margin="5" Name="RunNameTextBox"></TextBox>
            </DockPanel>
            <DockPanel Grid.Row="1">
                <TextBlock Padding="10">Run Notes:</TextBlock>
                <TextBox HorizontalAlignment="Stretch" Margin="5" Name="RunNotesTextBox"></TextBox>
            </DockPanel>
            <Grid Grid.Row="2" ColumnDefinitions="*,*">
                <Button Grid.Column="0" IsEnabled="False" Width="NaN" HorizontalAlignment="Stretch" Name="UpdateRunInfoButton" Click="UpdateRunInfoButton_OnClick">Update</Button>
                <Button Grid.Column="1" IsEnabled="False" Width="NaN" HorizontalAlignment="Stretch" Name="SaveFilesButton" Click="SaveFilesButton_OnClick">Save Files</Button>
            </Grid>
            <GridSplitter Grid.Row="3" IsEnabled="False" Background="Gray" ResizeDirection="Rows"/>

            <TextBlock Grid.Row="4" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="10" FontSize="18">Problematic Course Assignments</TextBlock>
            <DataGrid Grid.Row="5" Margin="20" 
                      ItemsSource="{ Binding RunDetails }"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="All"
                      BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }" />
                    <DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }" />
                    <DataGridTextColumn Header="Course Rank" Width="*" Binding="{ Binding Rank }" />
                    <DataGridTextColumn Header="Course Code" Width="*" Binding="{ Binding CourseCode }" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>