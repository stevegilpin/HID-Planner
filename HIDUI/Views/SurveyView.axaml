<UserControl x:Class="HIDUI.Views.SurveyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             xmlns:views="clr-namespace:HIDUI.Views"
             xmlns:objects="clr-namespace:Data.Objects;assembly=Data"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SurveyViewModel"
             mc:Ignorable="d">

	<Control.Styles>
		<StyleInclude Source="/ButtonStyles.axaml" />
		<Style Selector="Grid.DiffViewers > Button">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Width" Value="NaN"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
		</Style>
	</Control.Styles>
	
	<Grid VerticalAlignment="Top" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
		<Grid Grid.Row="0" ColumnDefinitions="*,*,*,*">
			<Button
				Grid.Column="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Width="NaN"
				Height="NaN"
				Margin="5"
				Click="ChooseFileOnClick">
				<TextBlock HorizontalAlignment="Center" FontWeight="Bold">Choose Files</TextBlock>
			</Button>
			
			<!-- survey file -->
			<views:FileSelectionControl 
				Grid.Column="1"
				Name="SurveyResponseFileSelector"
				DisplayName="Survey Responses"
				FilePath="{Binding SurveyFilePath }"
				RemoveFileCommand="{Binding RemoveSurveyFile }"/>
		        
			<!-- students file -->
			<views:FileSelectionControl 
				Grid.Column="2"
				Name="StudentsFileSelector"
				DisplayName="Students"
				FilePath="{Binding StudentsFilePath }"
				RemoveFileCommand="{Binding RemoveStudentsFile }"/>

			<!-- courses file -->
			<views:FileSelectionControl 
				Grid.Column="3"
				Name="CoursesFileSelector"
				DisplayName="Courses"
				FilePath="{Binding CoursesFilePath }"
				RemoveFileCommand="{Binding RemoveCoursesFile }"/>
		</Grid>
		
		<Grid Grid.Row="1" ColumnDefinitions="*,*,*">
			<Button
				Grid.Column="0"
				Width="NaN"
				IsEnabled="{Binding IsSurveyResponseFilePathSet}"
				HorizontalAlignment="Stretch"
				Margin="5"
				Padding="0 10"
				Click="ReconcileFilesOnClick">
				<TextBlock HorizontalAlignment="Center" FontWeight="Bold">Reconcile Files</TextBlock>
			</Button>
			<Button
				Grid.Column="1"
				Width="NaN"
				IsEnabled="{Binding FailuresLoaded}"
				HorizontalAlignment="Stretch"
				Margin="5"
				Padding="0 10"
				Click="SaveMissingResponsesOnClick">
				<TextBlock HorizontalAlignment="Center" FontWeight="Bold">Save Missing Responses List</TextBlock>
			</Button>
			<Button
				Grid.Column="2"
				Width="NaN"
				IsEnabled="{Binding CanSaveSchedulingInputs}"
				HorizontalAlignment="Stretch"
				Margin="5"
				Padding="0 10"
				Click="SaveSchedulingInputOnClick">
				<TextBlock HorizontalAlignment="Center" FontWeight="Bold">Save As Scheduling Input</TextBlock>
			</Button>
		</Grid>
		<TextBlock
			Grid.Row="2"
			HorizontalAlignment="Center"
			IsVisible="{ Binding FailuresLoaded }"
			Text="{Binding FailureSummary }"
			FontWeight="Bold"
			Padding="10"
			Foreground="{Binding FailureSummaryColor }"
		/>

		<GridSplitter Grid.Row="3" IsEnabled="False" Background="Gray" ResizeDirection="Rows"/>
		
		<!-- diff viewer selection buttons -->
		<Grid
			Grid.Row="4"
			Classes="DiffViewers"
			ColumnDefinitions="*, *, *, *, *"
			Margin="5 10"
			IsEnabled="{ Binding FailuresLoaded }">
			<Button
				Grid.Column = "0"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewMissingResponses_OnClick">
				View Missing Responses
				<ToolTip.Tip>
					<TextBlock FontSize="14" TextWrapping="Wrap">Expected responses based on the student roster which were not found in the survey responses</TextBlock>
				</ToolTip.Tip>
			</Button>
			<Button
				Grid.Column = "1"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewUnexpectedResponses_OnClick">
				View Unexpected Responses
				<ToolTip.Tip>
					<TextBlock FontSize="14" TextWrapping="Wrap">Survey responses which were not expected based on the student roster</TextBlock>
				</ToolTip.Tip>
			</Button>
			<Button 
				Grid.Column = "2"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewDuplicateResponses_OnClick">
				View Duplicate Responses
				<ToolTip.Tip>
					<TextBlock FontSize="14" TextWrapping="Wrap">Survey responses which appeared multiple times for one student</TextBlock>
				</ToolTip.Tip>
			</Button>
			<Button 
				Grid.Column = "3"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewInvalidCourseChoices_OnClick">
				View Invalid Course Choices
				<ToolTip.Tip>
					<TextBlock FontSize="14" TextWrapping="Wrap">Survey responses which selected a course that does not match any courses available to that student's grade</TextBlock>
				</ToolTip.Tip>
			</Button>
			<Button 
				Grid.Column = "4"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewIncompleteResponses_OnClick">
				View Incomplete Responses
				<ToolTip.Tip>
					<TextBlock FontSize="14" TextWrapping="Wrap">Survey responses which did not rank as many courses as other students in the same grade</TextBlock>
				</ToolTip.Tip>
			</Button>
        </Grid>

		<!-- diff data grids -->
		<Grid Grid.Row="5" RowDefinitions="*" ColumnDefinitions="*">
			<!-- No Response Failures -->
			<Grid ColumnDefinitions=".4*, 2, .3*" Name="NoResponseGrid" IsVisible="True">
				<Grid Grid.Column="0" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Missing Responses</TextBlock>
					<DataGrid
						Grid.Row="1"
						Margin="10 0"
						IsReadOnly="True"
						SelectionMode="Single"
						SelectionChanged="NoResponseGrid_OnSelectionChanged"
						ItemsSource="{ Binding NoResponseFailures }">
						<DataGrid.Columns>
							<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Student.FirstName }"/>
							<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Student.LastName }"/>
							<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Student.Grade }"/>
							<DataGridTextColumn Header="Homeroom" Width="*" Binding="{ Binding Student.Homeroom }"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

				<GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>
				
				<Grid Grid.Column="2" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Possible Matches</TextBlock>
					<DataGrid
						Grid.Row="1"
						Margin="10 0"
						IsReadOnly="True"
						ItemsSource="{ Binding NoResponseMatchCandidates }">
						<DataGrid.Columns>
							<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
							<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
							<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</Grid>

			<!-- Unexpected Response Failures -->
			<Grid ColumnDefinitions=".3*, 2, .4*" Name="UnexpectedResponseGrid" IsVisible="False">
				<Grid Grid.Column="0" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Unexpected Responses</TextBlock>
					<DataGrid
						Grid.Row="1"
						IsReadOnly="True"
						Margin="10 0"
						SelectionMode="Single"
						SelectionChanged="UnexpectedResponseGrid_OnSelectionChanged"
						Name="UnexpectedResponseGridData"
						ItemsSource="{ Binding UnexpectedRespondentFailures }">
						<DataGrid.Columns>
							<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
							<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
							<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>

				<GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>

				<Grid Grid.Column="2" RowDefinitions="Auto,*">
					<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Possible Matches</TextBlock>
					<DataGrid
						Grid.Row="1"
						IsReadOnly="True"
						Margin="10 0"
						ItemsSource="{ Binding UnexpectedRespondentMatchCandidates }">
						<DataGrid.Columns>
							<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
							<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
							<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
							<DataGridTextColumn Header="Homeroom" Width="*" Binding="{ Binding Homeroom }"/>
							<DataGridTemplateColumn Width="*" Header="Save Data">
								<DataTemplate DataType="objects:StudentInfo">
									<Button 
										Click="KeepMatchOnClick"
										Width="NaN"
										Height="NaN"
										FontSize="12"
										Content="Keep Match"/>
								</DataTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</Grid>

			<!-- Duplicate Response Failures -->
			<Grid Name="DuplicateResponseGrid" IsVisible="False" RowDefinitions="Auto,*">
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Duplicate Responses</TextBlock>
				<DataGrid
					Grid.Row="1"
					IsReadOnly="True"
					ItemsSource="{ Binding DuplicateResponseFailures }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Invalid Course Choice Failures -->
			<Grid Name="InvalidCourseChoiceGrid" IsVisible="False" RowDefinitions="Auto,*">
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Invalid Course Choices</TextBlock>
				<DataGrid
					Grid.Row="1"
					IsReadOnly="True"
					ItemsSource="{ Binding InvalidCourseChoiceFailures }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
						<DataGridTextColumn Header="Invalid Course" Width="*" Binding="{ Binding InvalidCourseChoice }"/>
						<DataGridTextColumn Header="Selection Problem" Width="*" Binding="{ Binding ProblemDescription }"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Incomplete Response Failures -->
			<Grid Name="IncompleteResponseGrid" IsVisible="False" RowDefinitions="Auto,*">
				<TextBlock Grid.Row="0" HorizontalAlignment="Center" Padding="12" FontWeight="SemiBold">Invalid Incomplete Responses</TextBlock>
				<DataGrid
					Grid.Row="1"
					IsReadOnly="True"
					ItemsSource="{ Binding IncompleteResponseFailures }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
						<DataGridTextColumn Header="Expected Ranking Count" Width="*" Binding="{ Binding ExpectedRankingsCount }"/>
						<DataGridTextColumn Header="Actual Ranking Count" Width="*" Binding="{ Binding Response.ClassRankings.Count }"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

		</Grid>
		
	</Grid>
    
</UserControl>
