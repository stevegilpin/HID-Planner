<UserControl x:Class="HIDUI.Views.SurveyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SurveyViewModel"
             mc:Ignorable="d">

	<StackPanel VerticalAlignment="Center">
        <DockPanel>
	        <Button>Choose Files</Button>
	        <!-- file selectors go here -->
        </DockPanel>

		<DockPanel>
			<Button>View Missing Responses</Button>
			<Button>View Unexpected Responses</Button>
			<Button>View Duplicate Responses</Button>
			<Button>View Invalid Course Choices</Button>
			<Button>View Incomplete Responses</Button>
        </DockPanel>

		<DockPanel>
			<DataGrid
				ItemsSource="{ Binding FailureList }"/>
			<DataGrid
				ItemsSource="{ Binding FailureDetailList }"/>	
		</DockPanel>
		

	</StackPanel>
    
</UserControl>
