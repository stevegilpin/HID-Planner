<UserControl x:Class="HIDUI.Views.SurveyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SurveyViewModel"
             mc:Ignorable="d">

	<StackPanel VerticalAlignment="Center">
        <StackPanel>
	        <Button HorizontalAlignment="Center" Padding="12" Click="ChooseFileOnClick">
		        <TextBlock Padding="50 8" FontWeight="Bold">Choose Files</TextBlock>
	        </Button>

	        <!-- survey file -->
	        <Border BorderBrush="{ Binding SurveyStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Survey Responses</TextBlock>
			        <StackPanel IsVisible="{ Binding IsSurveyResponseFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveSurveyFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding SurveyFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>
	        
	        <!-- students file -->
	        <Border BorderBrush="{ Binding StudentsStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Students</TextBlock>
			        <StackPanel IsVisible="{ Binding IsStudentInfoFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveStudentsFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding StudentInfoFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>

	        <!-- courses file -->
	        <Border BorderBrush="{ Binding CoursesStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Courses</TextBlock>
			        <StackPanel IsVisible="{ Binding IsCourseInfoFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveCoursesFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding CourseInfoFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>

        </StackPanel>

		<DockPanel>
			<Button>View Missing Responses</Button>
			<Button>View Unexpected Responses</Button>
			<Button>View Duplicate Responses</Button>
			<Button>View Invalid Course Choices</Button>
			<Button>View Incomplete Responses</Button>
        </DockPanel>

		<DockPanel>
			<DataGrid
				ItemsSource="{ Binding FailureList }"/>
			<DataGrid
				ItemsSource="{ Binding FailureDetailList }"/>	
		</DockPanel>
		

	</StackPanel>
    
</UserControl>
