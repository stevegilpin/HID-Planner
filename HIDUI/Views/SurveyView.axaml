<UserControl x:Class="HIDUI.Views.SurveyView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:CompileBindings="True"
             x:DataType="vm:SurveyViewModel"
             mc:Ignorable="d">

	<StackPanel VerticalAlignment="Center">
        <StackPanel>
	        <Button HorizontalAlignment="Center" Padding="12" Click="ChooseFileOnClick">
		        <TextBlock Padding="50 8" FontWeight="Bold">Choose Files</TextBlock>
	        </Button>

	        <!-- survey file -->
	        <Border BorderBrush="{ Binding SurveyStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Survey Responses</TextBlock>
			        <StackPanel IsVisible="{ Binding IsSurveyResponseFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveSurveyFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding SurveyFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>
	        
	        <!-- students file -->
	        <Border BorderBrush="{ Binding StudentsStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Students</TextBlock>
			        <StackPanel IsVisible="{ Binding IsStudentInfoFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveStudentsFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding StudentInfoFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>

	        <!-- courses file -->
	        <Border BorderBrush="{ Binding CoursesStatusColor }" BorderThickness="2" CornerRadius="3" Padding="5" Margin="5">
		        <StackPanel>
			        <TextBlock>Courses</TextBlock>
			        <StackPanel IsVisible="{ Binding IsCourseInfoFilePathSet }" Orientation="Horizontal">
				        <Button Classes="delete" Background="Transparent" Command="{ Binding RemoveCoursesFile }">
					        <Image Width="20" Height="20" Source="/Assets/delete.webp"/>
				        </Button>
				        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{ Binding CourseInfoFileName }"/>
			        </StackPanel>
		        </StackPanel>
	        </Border>
	        
	        <DockPanel HorizontalAlignment="Center">
		        <Button
			        IsEnabled="{Binding IsSurveyResponseFilePathSet}"
			        HorizontalAlignment="Left"
			        Margin="5 0"
			        Click="ReconcileFilesOnClick">
			        <TextBlock Padding="50 8" FontWeight="Bold">Reconcile Files</TextBlock>
		        </Button>
		        <Button
			        IsEnabled="{Binding AllFilePathsSet}"
			        HorizontalAlignment="Left"
			        Margin="5 0"
			        Click="SaveSchedulingInputOnClick">
			        <TextBlock Padding="50 8" FontWeight="Bold">Save As Scheduling Input</TextBlock>
		        </Button>
	        </DockPanel>
        </StackPanel>

		<Grid
			ColumnDefinitions="*, *, *, *, *"
			Margin="5 10"
			IsEnabled="{ Binding FailuresLoaded }">
			<Button
				Grid.Column = "0"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewMissingResponses_OnClick">
				<TextBlock HorizontalAlignment="Center" Padding="0 8" FontWeight="Bold">View Missing Responses</TextBlock>
			</Button>
			<Button
				Grid.Column = "1"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewUnexpectedResponses_OnClick">
				<TextBlock HorizontalAlignment="Center" Padding="0 8" FontWeight="Bold">View Unexpected Responses</TextBlock>
			</Button>
			<Button 
				Grid.Column = "2"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewDuplicateResponses_OnClick">
				<TextBlock HorizontalAlignment="Center" Padding="0 8" FontWeight="Bold">View Duplicate Responses</TextBlock>
			</Button>
			<Button 
				Grid.Column = "3"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewInvalidCourseChoices_OnClick">
				<TextBlock HorizontalAlignment="Center" Padding="0 8" FontWeight="Bold">View Invalid Course Choices</TextBlock>
				</Button>
			<Button 
				Grid.Column = "4"
				Margin="5 0"
				HorizontalAlignment="Stretch"
				Click="ViewIncompleteResponses_OnClick">
				<TextBlock HorizontalAlignment="Center" Padding="0 8" FontWeight="Bold">View Incomplete Responses</TextBlock>
				</Button>
        </Grid>

		<DockPanel>
			<!-- No Response Failures -->
			<Grid ColumnDefinitions="*, 2, *" Name="NoResponseGrid" IsVisible="True">
				<DataGrid
					Grid.Column="0"
					IsReadOnly="True"
					SelectionMode="Single"
					SelectionChanged="NoResponseGrid_OnSelectionChanged"
					ItemsSource="{ Binding NoResponseFailures }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Student.FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Student.LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Student.Grade }"/>
						<DataGridTextColumn Header="Homeroom" Width="*" Binding="{ Binding Student.Homeroom }"/>
					</DataGrid.Columns>
				</DataGrid>

				<GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>
				
				<DataGrid
					Grid.Column="2"
					IsReadOnly="True"
					ItemsSource="{ Binding NoResponseMatchCandidates }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Unexpected Response Failures -->
			<Grid ColumnDefinitions="*, 2, *" Name="UnexpectedResponseGrid" IsVisible="False">
				<DataGrid
					Grid.Column="0"
					IsReadOnly="True"
					SelectionMode="Single"
					SelectionChanged="UnexpectedResponseGrid_OnSelectionChanged"
					ItemsSource="{ Binding UnexpectedRespondentFailures }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
					</DataGrid.Columns>
				</DataGrid>

				<GridSplitter Grid.Column="1" Background="Gray" ResizeDirection="Columns"/>

				<DataGrid
					Grid.Column="2"
					IsReadOnly="True"
					ItemsSource="{ Binding UnexpectedRespondentMatchCandidates }">
					<DataGrid.Columns>
						<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
						<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
						<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
						<DataGridTextColumn Header="Homeroom" Width="*" Binding="{ Binding Homeroom }"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>

			<!-- Duplicate Response Failures -->
			<DataGrid
				Name="DuplicateResponseGrid"
				IsVisible="False"
				IsReadOnly="True"
				ItemsSource="{ Binding DuplicateResponseFailures }">
				<DataGrid.Columns>
					<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding FirstName }"/>
					<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding LastName }"/>
					<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Grade }"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Invalid Course Choice Failures -->
			<DataGrid
				Name="InvalidCourseChoiceGrid"
				IsVisible="False"
				IsReadOnly="True"
				ItemsSource="{ Binding InvalidCourseChoiceFailures }">
				<DataGrid.Columns>
					<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
					<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
					<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
					<DataGridTextColumn Header="Invalid Course" Width="*" Binding="{ Binding InvalidCourseChoice }"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- Incomplete Response Failures -->
			<DataGrid
				Name="IncompleteResponseGrid"
				IsVisible="False"
				IsReadOnly="True"
				ItemsSource="{ Binding IncompleteResponseFailures }">
				<DataGrid.Columns>
					<DataGridTextColumn Header="First Name" Width="*" Binding="{ Binding Response.FirstName }"/>
					<DataGridTextColumn Header="Last Name" Width="*" Binding="{ Binding Response.LastName }"/>
					<DataGridTextColumn Header="Grade" Width="*" Binding="{ Binding Response.Grade }"/>
					<DataGridTextColumn Header="Expected Ranking Count" Width="*" Binding="{ Binding ExpectedRankingsCount }"/>
					<DataGridTextColumn Header="Actual Ranking Count" Width="*" Binding="{ Binding Response.ClassRankings.Count }"/>
				</DataGrid.Columns>
			</DataGrid>

		</DockPanel>
		
	</StackPanel>
    
</UserControl>
