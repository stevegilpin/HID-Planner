<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:HIDUI.ViewModels"
             xmlns:view="using:HIDUI.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="HIDUI.Views.CourseOptionsView"
             x:DataType="vm:CourseOptionsViewModel">
    
    <Control.Styles>
        <StyleInclude Source="/ButtonStyles.axaml" />
    </Control.Styles>
    
    <StackPanel>
        <DockPanel VerticalAlignment="Center">
            <Button HorizontalAlignment="Center" Padding="12" Click="ChooseFileOnClick">
                Choose File
            </Button>
            <view:FileSelectionControl
                Name="CoursesFileSelector"
                DisplayName="Courses"
                FilePath="{Binding FilePath }"
                RemoveFileCommand="{Binding RemoveCoursesFile }"/>
        </DockPanel>

        <DockPanel>
            <TextBlock Padding="10">Document Header</TextBlock>
            <TextBox Margin="5" Name="DocumentHeaderBox" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="SetDocumentHeader"></TextBox>
        </DockPanel>
        <DockPanel>
            <TextBlock Padding="10">Event Description</TextBlock>
            <TextBox Margin="5" Name="EventDescriptionBox" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="SetEventDescription"></TextBox>
        </DockPanel>
        
        <Button IsEnabled="{ Binding IsInputReady }" HorizontalAlignment="Left" Padding="12" Click="SaveCourseDescrFileOnClick">
            Save Course Descriptions
        </Button>
        <Button IsEnabled="{ Binding IsInputReady }" HorizontalAlignment="Left" Padding="12" Click="SaveCourseListFileOnClick">
            Save Course Topic List
        </Button>
    </StackPanel>
</UserControl>
