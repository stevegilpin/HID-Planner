<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:testUi="clr-namespace:TestUI"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TestUI.MainWindow"
        Title="TestUI">
    <StackPanel Name="MyPanel" Margin="20">
        <Button Click="ClickHandler">Press Me!</Button>
        <TextBlock Margin="0 10" x:Name="message">Ready...</TextBlock>
        <!-- <testUi:MyControl1></testUi:MyControl1> -->
    </StackPanel>
</Window>
